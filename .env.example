# MongoDB Atlas connection string (replica set required for transactions; Atlas provides one)
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/vidyaverse?retryWrites=true&w=majority

# Generate all secrets below with: npm run keys
AUTH_SECRET=
# Ed25519 keypair as base64-encoded JWKs (used for W3C VCs, SD-JWT, signed PDFs, consent artefacts)
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=
# HMAC secret for APAAR tokenisation and contact hashes
HMAC_SECRET=
# 32-byte key (base64) for AES-256-GCM field encryption
FIELD_ENCRYPTION_KEY=

# Meta WhatsApp Cloud API (leave empty to run in MOCK mode)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

