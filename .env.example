# Public domain of the deployment, used for did:web and verification links (no protocol), e.g. vidyaverse.vercel.app
APP_DOMAIN=localhost:3000

# Protects /api/cron/* (Vercel sends it automatically as Bearer token)
CRON_SECRET=

# Show the mock OTP in a toast in production (demo deployments only)
DEMO_MODE=true
